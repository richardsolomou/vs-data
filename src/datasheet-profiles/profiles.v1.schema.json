{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/vs-data/src/datasheet-profiles/profiles.v1.schema.json",
  "title": "Datasheet profile record data, format version 1",
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "positive": { "type": "integer", "minimum": 1 },
    "roll": { "type": "integer", "minimum": 2 },
    "amount": {
      "oneOf": [{ "$ref": "#/$defs/positive" }, { "type": "string", "pattern": "^(?:[1-9][0-9]*)?D[1-9][0-9]*(?:\\+[1-9][0-9]*)?$" }]
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string", "pattern": "^[a-z][a-zA-Z]*$" },
          "reason": { "enum": ["no-source", "no-target", "unrepresentable"] }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "anyOf": [{ "required": ["page"] }, { "required": ["url"] }],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "page": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "pattern": "^https://\\S+$" },
        "revision": { "$ref": "#/$defs/text" }
      }
    },
    "base": {
      "oneOf": [
        { "enum": ["hull", "unique"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["diameter"],
          "properties": { "diameter": { "type": "number", "exclusiveMinimum": 0 }, "approximate": { "const": true }, "flying": { "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["length", "width"],
          "properties": {
            "length": { "type": "number", "exclusiveMinimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "approximate": { "const": true },
            "flying": { "const": true }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["flyingBase"], "properties": { "flyingBase": { "enum": ["large", "small"] } } }
      ]
    },
    "base-choice": {
      "oneOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alternatives"],
          "properties": { "alternatives": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/base" } } }
        }
      ]
    },
    "base-equipped": {
      "oneOf": [
        { "$ref": "#/$defs/base-choice" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "withWargear"],
          "properties": {
            "size": { "$ref": "#/$defs/base-choice" },
            "withWargear": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["wargear", "size"],
                "properties": { "wargear": { "$ref": "#/$defs/ids" }, "size": { "$ref": "#/$defs/base-choice" } }
              }
            }
          }
        }
      ]
    },
    "base-size": {
      "oneOf": [
        { "$ref": "#/$defs/base-equipped" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["byModel"],
          "properties": {
            "byModel": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["models", "size"],
                "properties": { "models": { "$ref": "#/$defs/ids" }, "size": { "$ref": "#/$defs/base-equipped" } }
              }
            }
          }
        }
      ]
    },
    "invulnerable-save": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roll"],
      "dependentRequired": { "summary": ["conditional"] },
      "properties": {
        "roll": { "$ref": "#/$defs/roll" },
        "against": { "enum": ["ranged", "melee"] },
        "conditional": { "const": true },
        "summary": { "$ref": "#/$defs/text", "description": "When the save applies, as Markdown in the rule summary grammar without links; validateProfiles parses it." }
      }
    },
    "unit-profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "dependentRequired": { "baseSizeSource": ["baseSize"] },
      "properties": {
        "unit": { "$ref": "#/$defs/id" },
        "models": { "$ref": "#/$defs/ids" },
        "movement": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["atLeast"], "properties": { "atLeast": { "$ref": "#/$defs/positive" } } }
          ]
        },
        "toughness": { "$ref": "#/$defs/positive" },
        "save": { "$ref": "#/$defs/roll" },
        "wounds": { "$ref": "#/$defs/positive" },
        "leadership": { "$ref": "#/$defs/roll" },
        "objectiveControl": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "invulnerableSave": {
          "if": { "type": "array" },
          "then": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/invulnerable-save", "type": "object", "required": ["against"] } },
          "else": { "$ref": "#/$defs/invulnerable-save" }
        },
        "baseSize": { "$ref": "#/$defs/base-size" },
        "baseSizeSource": { "$ref": "#/$defs/source", "description": "The source that prints the base size, where it is not the record's own source." },
        "gaps": { "$ref": "#/$defs/gaps" }
      }
    },
    "weapon-profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "unit": { "$ref": "#/$defs/id" },
        "wargear": { "$ref": "#/$defs/id" },
        "range": { "oneOf": [{ "$ref": "#/$defs/positive" }, { "const": "melee" }] },
        "attacks": { "$ref": "#/$defs/amount" },
        "skill": { "oneOf": [{ "$ref": "#/$defs/roll" }, { "type": "null" }] },
        "strength": { "$ref": "#/$defs/positive" },
        "armourPenetration": { "type": "integer", "maximum": 0 },
        "damage": { "$ref": "#/$defs/amount" },
        "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "gaps": { "$ref": "#/$defs/gaps" }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "minProperties": 2,
      "properties": {
        "unit": { "$ref": "#/$defs/id" },
        "leads": { "$ref": "#/$defs/ids" },
        "supports": { "$ref": "#/$defs/ids" },
        "conditional": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conditional-attachment" } },
        "withAnotherLeader": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/beside-leader" } },
        "joins": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/joining" } },
        "insteadOf": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stand-in" } },
        "capacity": { "$ref": "#/$defs/attachment-capacity" },
        "gaps": { "$ref": "#/$defs/gaps" }
      }
    },
    "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/keyword" } },
    "beside-leader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units"],
      "properties": {
        "units": { "$ref": "#/$defs/ids" },
        "besideUnits": { "$ref": "#/$defs/ids" },
        "besideKeywords": { "$ref": "#/$defs/keywords" }
      }
    },
    "stand-in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units"],
      "properties": {
        "units": { "$ref": "#/$defs/ids" },
        "role": { "enum": ["leads", "supports"] },
        "keywords": { "$ref": "#/$defs/keywords" },
        "excludedKeywords": { "$ref": "#/$defs/keywords" }
      }
    },
    "attachment-capacity": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["leads"] }, { "required": ["supports"] }],
      "properties": {
        "leads": { "type": "integer", "minimum": 2 },
        "supports": { "type": "integer", "minimum": 2 },
        "startingStrength": { "$ref": "#/$defs/positive" },
        "distinct": { "const": true },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keywords", "max"],
            "properties": { "keywords": { "$ref": "#/$defs/keywords" }, "max": { "$ref": "#/$defs/positive" } }
          }
        }
      }
    },
    "joining": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["units"] }, { "required": ["keywords"] }, { "required": ["ledBy"] }],
      "properties": {
        "units": { "$ref": "#/$defs/ids" },
        "keywords": { "$ref": "#/$defs/keywords" },
        "ledBy": { "$ref": "#/$defs/keywords" },
        "required": { "const": true },
        "exclusive": { "$ref": "#/$defs/keywords" }
      }
    },
    "keyword": { "type": "string", "pattern": "^[^\\s\\p{Ll}](?:[^\\p{Ll}]*[^\\s\\p{Ll}])?$", "description": "A keyword as printed in capitals." },
    "conditional-attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "anyOf": [{ "required": ["units"] }, { "required": ["keywords"] }],
      "dependentRequired": { "excludedKeywords": ["keywords"] },
      "properties": {
        "role": { "enum": ["leads", "supports"] },
        "units": { "$ref": "#/$defs/ids" },
        "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/keyword" } },
        "excludedKeywords": { "$ref": "#/$defs/keywords" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "faction": { "$ref": "#/$defs/id" },
            "detachment": { "$ref": "#/$defs/id" },
            "withoutDetachment": { "$ref": "#/$defs/id" },
            "withUnit": { "$ref": "#/$defs/id" },
            "withoutUnit": { "$ref": "#/$defs/id" }
          }
        },
        "shared": { "$ref": "#/$defs/keyword" }
      }
    },
    "selectors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "transportPool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "count", "selectors"],
      "properties": {
        "limit": { "$ref": "#/$defs/positive" },
        "count": { "enum": ["models", "units"] },
        "selectors": { "$ref": "#/$defs/selectors" },
        "maxWounds": { "$ref": "#/$defs/positive" }
      }
    },
    "transport-profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "firingDeck": { "$ref": "#/$defs/positive" },
        "unit": { "$ref": "#/$defs/id" },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["loads"],
          "properties": {
            "loads": {
              "type": "array", "minItems": 1,
              "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transportPool" } }
            },
            "whenEquipped": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["pool"],
                "oneOf": [{ "required": ["wargear"] }, { "required": ["model"] }],
                "properties": { "wargear": { "$ref": "#/$defs/id" }, "model": { "$ref": "#/$defs/id" }, "pool": { "$ref": "#/$defs/transportPool" } }
              }
            },
            "excluded": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["selectors"],
                "properties": { "selectors": { "$ref": "#/$defs/selectors" }, "except": { "$ref": "#/$defs/selectors" } }
              }
            },
            "space": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["size"],
                "properties": {
                  "selectors": { "$ref": "#/$defs/selectors" },
                  "moreWoundsThan": { "type": "integer", "minimum": 0 },
                  "size": { "$ref": "#/$defs/positive" }
                }
              }
            }
          }
        },
        "gaps": { "$ref": "#/$defs/gaps" }
      }
    }
  }
}
