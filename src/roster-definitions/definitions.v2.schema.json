{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richardsolomou/vs-data/src/roster-definitions/definitions.v2.schema.json",
  "title": "Roster definition record data, format version 2",
  "$defs": {
    "version": {
      "const": 2
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "names": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "someCounts": {
      "allOf": [
        {
          "$ref": "#/$defs/counts"
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/count"
        },
        "max": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "sizeBounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "size",
          "min",
          "max"
        ],
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "min": {
            "$ref": "#/$defs/count"
          },
          "max": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "sizeMaxima": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "size",
          "max"
        ],
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "max": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "choices": {
      "allOf": [
        {
          "$ref": "#/$defs/ids"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "per": {
      "oneOf": [
        {
          "const": "carrier"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "models"
          ],
          "properties": {
            "models": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "faction": {
          "$ref": "#/$defs/id"
        },
        "detachment": {
          "$ref": "#/$defs/id"
        },
        "warlord": {
          "$ref": "#/$defs/id"
        },
        "allegiance": {
          "$ref": "#/$defs/id"
        },
        "wargear": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "faction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion"
      ],
      "properties": {
        "formatVersion": {
          "$ref": "#/$defs/version"
        },
        "unitLimits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "dependentRequired": {
              "exclusive": [
                "anyOf"
              ]
            },
            "required": [
              "keywords"
            ],
            "properties": {
              "keywords": {
                "allOf": [
                  {
                    "$ref": "#/$defs/keywords"
                  },
                  {
                    "type": "array",
                    "minItems": 1
                  }
                ]
              },
              "anyOf": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/keywords"
                    },
                    {
                      "type": "array",
                      "minItems": 1
                    }
                  ]
                }
              },
              "exclusive": {
                "const": true
              },
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "max": {
                "$ref": "#/$defs/count"
              },
              "detachments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "detachment"
                  ],
                  "properties": {
                    "detachment": {
                      "$ref": "#/$defs/id"
                    },
                    "min": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max": {
                      "$ref": "#/$defs/count"
                    }
                  }
                }
              }
            }
          }
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "excludedUnits": {
          "$ref": "#/$defs/choices"
        },
        "excludedDetachments": {
          "$ref": "#/$defs/choices"
        },
        "withoutDetachments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "warlords"
          ],
          "properties": {
            "warlords": {
              "$ref": "#/$defs/choices"
            },
            "dispositions": {
              "$ref": "#/$defs/choices"
            }
          }
        },
        "allies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "$ref": "#/$defs/choices"
              },
              "detachments": {
                "$ref": "#/$defs/choices"
              },
              "points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "battleSize",
                    "max"
                  ],
                  "properties": {
                    "battleSize": {
                      "$ref": "#/$defs/id"
                    },
                    "max": {
                      "$ref": "#/$defs/count"
                    }
                  }
                }
              },
              "limits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "keywords",
                    "battleSize",
                    "max"
                  ],
                  "properties": {
                    "keywords": {
                      "$ref": "#/$defs/nonEmptyKeywords"
                    },
                    "battleSize": {
                      "$ref": "#/$defs/id"
                    },
                    "max": {
                      "$ref": "#/$defs/count"
                    },
                    "free": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "keywords",
                          "per"
                        ],
                        "properties": {
                          "keywords": {
                            "$ref": "#/$defs/nonEmptyKeywords"
                          },
                          "per": {
                            "$ref": "#/$defs/nonEmptyKeywords"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "oneLimit": {
                "const": true
              },
              "enhancements": {
                "const": true
              }
            },
            "dependentRequired": {
              "oneLimit": [
                "limits"
              ]
            }
          }
        }
      }
    },
    "battle-size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "points"
      ],
      "properties": {
        "formatVersion": {
          "$ref": "#/$defs/version"
        },
        "points": {
          "type": "integer",
          "minimum": 1
        },
        "detachmentPoints": {
          "$ref": "#/$defs/count"
        },
        "enhancements": {
          "$ref": "#/$defs/count"
        },
        "duplicates": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "detachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "faction"
      ],
      "dependentRequired": {
        "stratagems": [
          "enhancements"
        ],
        "enhancements": [
          "stratagems"
        ],
        "stratagemsUnlisted": [
          "stratagems"
        ],
        "enhancementsUnlisted": [
          "enhancements"
        ]
      },
      "properties": {
        "formatVersion": {
          "$ref": "#/$defs/version"
        },
        "faction": {
          "$ref": "#/$defs/id"
        },
        "stratagems": {
          "$ref": "#/$defs/ids"
        },
        "enhancements": {
          "$ref": "#/$defs/ids"
        },
        "stratagemsUnlisted": {
          "$ref": "#/$defs/names"
        },
        "enhancementsUnlisted": {
          "$ref": "#/$defs/names"
        },
        "dispositions": {
          "$ref": "#/$defs/choices"
        },
        "excludedUnits": {
          "$ref": "#/$defs/choices"
        },
        "warlords": {
          "$ref": "#/$defs/choices"
        },
        "requiredWarlords": {
          "$ref": "#/$defs/choices"
        },
        "group": {
          "$ref": "#/$defs/text"
        },
        "exclusiveEnhancements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keywords"
          ],
          "properties": {
            "keywords": {
              "$ref": "#/$defs/names"
            }
          }
        },
        "allegianceLimits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "allegiances"
            ],
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              }
            ],
            "properties": {
              "allegiances": {
                "$ref": "#/$defs/choices"
              },
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "max": {
                "$ref": "#/$defs/count"
              }
            }
          }
        }
      }
    },
    "enhancement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "detachment",
        "eligibility"
      ],
      "properties": {
        "formatVersion": {
          "$ref": "#/$defs/version"
        },
        "detachment": {
          "$ref": "#/$defs/id"
        },
        "upgrade": {
          "const": true
        },
        "perRoster": {
          "type": "integer",
          "minimum": 2
        },
        "outsideLimit": {
          "const": true
        },
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anyOf"
          ],
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "keywords": {
                    "$ref": "#/$defs/names"
                  },
                  "unit": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            },
            "excludedKeywords": {
              "$ref": "#/$defs/names"
            },
            "requiredWargear": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "epicHeroes": {
              "const": true
            },
            "nonCharacters": {
              "const": true
            },
            "notWarlord": {
              "const": true
            }
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "faction",
        "keywords",
        "sizes"
      ],
      "properties": {
        "formatVersion": {
          "$ref": "#/$defs/version"
        },
        "faction": {
          "$ref": "#/$defs/id"
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        },
        "factionKeywords": {
          "$ref": "#/$defs/nonEmptyKeywords"
        },
        "conditionalKeywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "keywords",
              "when"
            ],
            "properties": {
              "keywords": {
                "allOf": [
                  {
                    "$ref": "#/$defs/keywords"
                  },
                  {
                    "type": "array",
                    "minItems": 1
                  }
                ]
              },
              "replaces": {
                "allOf": [
                  {
                    "$ref": "#/$defs/keywords"
                  },
                  {
                    "type": "array",
                    "minItems": 1
                  }
                ]
              },
              "when": {
                "$ref": "#/$defs/when"
              }
            }
          }
        },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "compositions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "$ref": "#/$defs/id"
            },
            "additionalProperties": {
              "$ref": "#/$defs/bounds"
            }
          }
        },
        "modelGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "models",
              "min",
              "max"
            ],
            "properties": {
              "models": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ids"
                  },
                  {
                    "type": "array",
                    "minItems": 2
                  }
                ]
              },
              "min": {
                "$ref": "#/$defs/count"
              },
              "max": {
                "$ref": "#/$defs/count"
              },
              "bySize": {
                "$ref": "#/$defs/sizeBounds"
              }
            }
          }
        },
        "optionGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "options",
              "max"
            ],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "option"
                  ],
                  "properties": {
                    "option": {
                      "$ref": "#/$defs/id"
                    },
                    "choices": {
                      "$ref": "#/$defs/choices"
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 2
                    }
                  }
                }
              },
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "max": {
                "type": "integer",
                "minimum": 1
              },
              "carrier": {
                "$ref": "#/$defs/id"
              },
              "per": {
                "$ref": "#/$defs/per"
              },
              "bySize": {
                "$ref": "#/$defs/sizeMaxima"
              }
            }
          }
        },
        "uniformOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "perRoster": {
          "$ref": "#/$defs/count"
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "battleSize",
              "perRoster"
            ],
            "properties": {
              "battleSize": {
                "$ref": "#/$defs/id"
              },
              "perRoster": {
                "$ref": "#/$defs/count"
              },
              "when": {
                "$ref": "#/$defs/when"
              }
            }
          }
        },
        "legends": {
          "const": true
        },
        "crucible": {
          "const": true
        },
        "coreAbilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/core-ability"
          }
        },
        "enhancements": {
          "const": false
        },
        "wargear": {
          "$ref": "#/$defs/counts"
        },
        "defaults": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/someCounts"
          }
        },
        "defaultModels": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/count"
          }
        },
        "allegiances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "$ref": "#/$defs/choices"
              },
              "required": {
                "const": true
              },
              "detachment": {
                "$ref": "#/$defs/id"
              },
              "requires": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "$ref": "#/$defs/id"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "unit",
        "min",
        "max",
        "wargear"
      ],
      "properties": {
        "formatVersion": {
          "$ref": "#/$defs/version"
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "min": {
          "$ref": "#/$defs/count"
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "bySize": {
          "$ref": "#/$defs/sizeBounds"
        },
        "wargear": {
          "$ref": "#/$defs/counts"
        },
        "keywords": {
          "$ref": "#/$defs/nonEmptyKeywords"
        },
        "warlord": {
          "const": false
        }
      }
    },
    "roster-option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "unit",
        "choose",
        "choices"
      ],
      "properties": {
        "formatVersion": {
          "$ref": "#/$defs/version"
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "carrier": {
          "$ref": "#/$defs/id"
        },
        "choose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/count"
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "per": {
          "$ref": "#/$defs/per"
        },
        "bySize": {
          "$ref": "#/$defs/sizeBounds"
        },
        "uniform": {
          "const": true
        },
        "substitutes": {
          "$ref": "#/$defs/choices"
        },
        "replaces": {
          "$ref": "#/$defs/someCounts"
        },
        "choices": {
          "$ref": "#/$defs/choices"
        },
        "caps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "choices",
              "max"
            ],
            "properties": {
              "choices": {
                "$ref": "#/$defs/choices"
              },
              "max": {
                "type": "integer",
                "minimum": 1
              },
              "per": {
                "$ref": "#/$defs/per"
              },
              "bySize": {
                "$ref": "#/$defs/sizeMaxima"
              }
            }
          }
        },
        "requires": {
          "oneOf": [
            {
              "$ref": "#/$defs/requirement"
            },
            {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/requirement"
              }
            }
          ]
        }
      }
    },
    "wargear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion"
      ],
      "properties": {
        "formatVersion": {
          "$ref": "#/$defs/version"
        },
        "includes": {
          "$ref": "#/$defs/someCounts"
        }
      }
    },
    "nonEmptyKeywords": {
      "allOf": [
        {
          "$ref": "#/$defs/keywords"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "allegiance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion"
      ],
      "properties": {
        "formatVersion": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "core-ability": {
      "type": "object",
      "required": [
        "ability"
      ],
      "properties": {
        "ability": {
          "enum": [
            "damaged",
            "deadly-demise",
            "deep-strike",
            "feel-no-pain",
            "fights-first",
            "hover",
            "infiltrators",
            "leader",
            "lone-operative",
            "scouts",
            "stealth",
            "super-heavy-walker",
            "support"
          ]
        },
        "models": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "ability"
            ],
            "properties": {
              "ability": {
                "const": "damaged"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "ability",
              "wounds"
            ],
            "properties": {
              "ability": true,
              "models": true,
              "wounds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
